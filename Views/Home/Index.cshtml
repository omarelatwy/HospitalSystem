@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold text-primary mb-3">Welcome to Hospital Appointment System</h1>
    <p class="lead text-muted mb-5">Easily manage and book your medical appointments online.</p>
    
    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary btn-lg px-4 shadow">
            <i class="bi bi-calendar-plus"></i> Make Appointment
        </a>
        <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 shadow-sm">
            <i class="bi bi-list-check"></i> View Appointments
        </a>
    </div>
</div>
